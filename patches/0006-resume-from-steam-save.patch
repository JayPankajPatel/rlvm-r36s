+void RLMachine::LoadResumeBanks() {
+  LocalMemory& local = memory_->local();
+  int* banks[] = {local.intA, local.intB, local.intC,
+                  local.intD, local.intE, local.intF};
+  const size_t count = sizeof(banks) / sizeof(banks[0]);
+  if (resume_banks_.size() < count * SIZE_OF_MEM_BANK)
+    return;
+  for (size_t i = 0; i < count; ++i) {
+    std::copy(resume_banks_.begin() + i * SIZE_OF_MEM_BANK,
+              resume_banks_.begin() + (i + 1) * SIZE_OF_MEM_BANK,
+              banks[i]);
+  }
+}
+
+void RLMachine::SetResume(size_t offset, std::vector<int> banks) {
+  const StackFrame& frame = call_stack_.back();
+  resume_scenario_ = frame.scenario;
+  resume_ip_ = frame.scenario->FindOffset(offset);
+  resume_banks_ = std::move(banks);
+  resume_active_ = true;
+  system().set_force_fast_forward(true);
+  LoadResumeBanks();
+}
+
 void RLMachine::SetHaltOnException(bool halt_on_exception) {
