+              g_game_w, g_game_h, g_out_w, g_out_h);
+      BindOffscreen();
+      glClear(GL_COLOR_BUFFER_BIT);
+    }
+  } else if (out_w > 0) {
+    fprintf(stderr, "rlvm: RLVM_OUTPUT_SIZE set but framebuffer objects "
