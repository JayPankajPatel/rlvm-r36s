+bool ButtonObjectSelectLongOperation::KeyStateChanged(KeyCode key_code,
+                                                      bool pressed) {
+  if (!pressed)
+    return false;
+
+  if (key_code == RLKEY_RETURN) {
+    // Confirm the highlighted button.
+    MouseButtonStateChanged(MOUSE_LEFT, true);
+    MouseButtonStateChanged(MOUSE_LEFT, false);
+    return true;
+  }
+
+  std::vector<Rect> rects;
+  for (ButtonPair& button_pair : buttons_) {
+    if (button_pair.first->has_object_data()) {
+      GraphicsObjectData* data = &button_pair.first->GetObjectData();
+      rects.push_back(data->DstRect(*button_pair.first, button_pair.second));
+    }
+  }
+
+  EventSystem& es = machine_.system().event();
+  Point target;
+  if (!PickMenuTarget(key_code, rects, es.GetCursorPos(), &target))
+    return false;
+  es.InjectMouseMovement(machine_, target);
+  return true;
+}
