+// Arrow-key navigation for pointer-driven menus, for devices without a mouse
+// (handhelds). Up/Left pick the previous button and Down/Right the next one,
+// in reading order; the pointer is then moved onto it.
+#ifndef SRC_LONG_OPERATIONS_KEYBOARD_NAV_H_
+#define SRC_LONG_OPERATIONS_KEYBOARD_NAV_H_
+
+#include <algorithm>
+#include <vector>
+
+#include "systems/base/event_listener.h"
+#include "systems/base/rect.h"
+
+// Returns true, and sets |*target| to the centre of the button to move to, if
+// |key| is an arrow key and there is at least one button.
+inline bool PickMenuTarget(KeyCode key,
+                           std::vector<Rect> rects,
+                           const Point& cursor,
+                           Point* target) {
+  int dir;
+  switch (key) {
+    case RLKEY_DOWN:
+    case RLKEY_RIGHT:
+      dir = 1;
+      break;
+    case RLKEY_UP:
+    case RLKEY_LEFT:
+      dir = -1;
+      break;
+    default:
+      return false;
+  }
+  if (rects.empty())
+    return false;
+
+  std::sort(rects.begin(), rects.end(), [](const Rect& a, const Rect& b) {
+    return a.y() != b.y() ? a.y() < b.y() : a.x() < b.x();
+  });
+  int n = static_cast<int>(rects.size());
+  int current = -1;
+  for (int i = 0; i < n; ++i) {
+    if (rects[i].Contains(cursor)) {
+      current = i;
+      break;
+    }
+  }
+  int next = current < 0 ? (dir > 0 ? 0 : n - 1) : (current + dir + n) % n;
+  const Rect& r = rects[next];
+  *target = Point(r.x() + r.width() / 2, r.y() + r.height() / 2);
+  return true;
+}
+
+#endif  // SRC_LONG_OPERATIONS_KEYBOARD_NAV_H_
