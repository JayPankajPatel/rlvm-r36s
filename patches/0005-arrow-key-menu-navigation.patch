+// Arrow-key navigation for pointer-driven menus, for devices without a mouse
+// (handhelds). Each arrow key moves the pointer onto the nearest button in
+// that direction.
+#ifndef SRC_LONG_OPERATIONS_KEYBOARD_NAV_H_
+#define SRC_LONG_OPERATIONS_KEYBOARD_NAV_H_
+
+#include <algorithm>
+#include <cstdlib>
+#include <vector>
+
+#include "systems/base/event_listener.h"
+#include "systems/base/rect.h"
+
+// Returns true, and sets |*target| to the centre of the button to move to, if
+// |key| is an arrow key and there is somewhere to go.
+//
+// If the pointer is not on any button, the first button in reading order is
+// picked whatever the key. Otherwise the nearest button in the key's
+// direction wins, weighting sideways offset more than distance; at the edge
+// of the menu it wraps around to the far side of the same row or column.
+inline bool PickMenuTarget(KeyCode key,
+                           std::vector<Rect> rects,
+                           const Point& cursor,
+                           Point* target) {
+  // Unit step along the key's direction.
+  int dx = 0, dy = 0;
+  switch (key) {
+    case RLKEY_DOWN:
+      dy = 1;
+      break;
+    case RLKEY_UP:
+      dy = -1;
+      break;
+    case RLKEY_RIGHT:
+      dx = 1;
+      break;
+    case RLKEY_LEFT:
+      dx = -1;
+      break;
+    default:
+      return false;
+  }
+  if (rects.empty())
+    return false;
+
+  std::sort(rects.begin(), rects.end(), [](const Rect& a, const Rect& b) {
+    return a.y() != b.y() ? a.y() < b.y() : a.x() < b.x();
+  });
+  const int n = static_cast<int>(rects.size());
+  auto centre = [&](int i) {
+    return Point(rects[i].x() + rects[i].width() / 2,
+                 rects[i].y() + rects[i].height() / 2);
+  };
+
+  int current = -1;
+  for (int i = 0; i < n; ++i) {
+    if (rects[i].Contains(cursor)) {
+      current = i;
+      break;
+    }
+  }
+
+  int next = 0;
+  if (current >= 0) {
+    const Point from = centre(current);
+    int best_score = 0;
+    int best = -1;
+    int wrap_score = 0;
+    int wrap = -1;
+    for (int i = 0; i < n; ++i) {
+      if (i == current)
+        continue;
+      const Point to = centre(i);
+      const int along = (to.x() - from.x()) * dx + (to.y() - from.y()) * dy;
+      const int across = std::abs((to.x() - from.x()) * dy) +
+                         std::abs((to.y() - from.y()) * dx);
+      if (along > 0) {
+        const int score = along + 2 * across;
+        if (best < 0 || score < best_score) {
+          best = i;
+          best_score = score;
+        }
+      } else if (along < 0) {
+        // Candidate for wrapping: same row/column first, then the farthest.
+        const int score = 4 * across - (-along);
+        if (wrap < 0 || score < wrap_score) {
+          wrap = i;
+          wrap_score = score;
+        }
+      }
+    }
+    next = best >= 0 ? best : wrap;
+    if (next < 0)
+      return false;  // nowhere to go (e.g. Left/Right in a single column)
+  }
+
+  *target = centre(next);
+  return true;
+}
+
+#endif  // SRC_LONG_OPERATIONS_KEYBOARD_NAV_H_
