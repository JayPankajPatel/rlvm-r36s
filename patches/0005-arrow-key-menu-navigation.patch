+// On-screen areas of all visible button graphics objects (title/menu buttons
+// that the game script hit-tests against the pointer itself).
+std::vector<Rect> VisibleButtonRects(RLMachine& machine) {
+  std::vector<Rect> rects;
+  GraphicsSystem& graphics = machine.system().graphics();
+  for (GraphicsObject& obj : graphics.GetForegroundObjects()) {
+    if (obj.IsButton() && obj.visible() && obj.has_object_data() &&
+        !dynamic_cast<ParentGraphicsObjectData*>(&obj.GetObjectData())) {
+      rects.push_back(obj.GetObjectData().DstRect(obj, NULL));
+    } else if (obj.has_object_data()) {
+      ParentGraphicsObjectData* parent =
+          dynamic_cast<ParentGraphicsObjectData*>(&obj.GetObjectData());
+      if (parent) {
+        for (GraphicsObject& child : parent->objects()) {
+          if (child.IsButton() && child.visible() && child.has_object_data())
+            rects.push_back(child.GetObjectData().DstRect(child, &obj));
+        }
+      }
+    }
+  }
+
+  if (rects.empty()) {
+    // Many menus (e.g. the title screen) are plain objects that the game
+    // script hit-tests itself. Treat the largest group of three or more
+    // visible, identically sized, smallish objects as the menu entries.
+    Size screen = graphics.screen_size();
+    const int screen_area = screen.width() * screen.height();
+
+    // Only plain image objects are measured: asking other kinds (e.g.
+    // containers) for their rectangle without a parent is not safe.
+    auto measure = [&](GraphicsObject& obj, GraphicsObject* parent,
+                       Rect* out) -> bool {
+      if (!obj.visible() || !obj.has_object_data())
+        return false;
+      if (!dynamic_cast<GraphicsObjectOfFile*>(&obj.GetObjectData()))
+        return false;
+      *out = obj.GetObjectData().DstRect(obj, parent);
+      return out->width() > 0 && out->height() > 0;
+    };
+
+    // Menus that were drawn earlier stay in the object list underneath later
+    // screens (e.g. the title menu under the Load screen). A visible
+    // full-screen object hides everything before it, so only consider objects
+    // that come after the last one.
+    int cover = -1;
+    int index = 0;
+    for (GraphicsObject& obj : graphics.GetForegroundObjects()) {
+      Rect r;
+      if (measure(obj, NULL, &r) && r.width() * r.height() >= screen_area * 8 / 10)
+        cover = index;
+      index++;
+    }
+
+    std::map<std::pair<int, int>, std::vector<Rect>> groups;
+    auto add = [&](const Rect& r) {
+      if (r.x() < 0 || r.y() < 0 || r.x2() > screen.width() ||
+          r.y2() > screen.height())
+        return;
+      if (r.width() * r.height() > screen_area / 8)
+        return;
+      groups[std::make_pair(r.width(), r.height())].push_back(r);
+    };
+
+    index = 0;
+    for (GraphicsObject& obj : graphics.GetForegroundObjects()) {
+      if (index++ <= cover)
+        continue;
+      Rect r;
+      if (measure(obj, NULL, &r)) {
+        add(r);
+      } else if (obj.visible() && obj.has_object_data()) {
+        // Screens like Load keep their entries inside a container object.
+        ParentGraphicsObjectData* parent =
+            dynamic_cast<ParentGraphicsObjectData*>(&obj.GetObjectData());
+        if (parent) {
+          for (GraphicsObject& child : parent->objects()) {
+            if (measure(child, &obj, &r))
+              add(r);
+          }
+        }
+      }
+    }
+
+    // The largest group of three or more same-sized entries is the menu;
+    // prefer the bigger entries on a tie.
+    size_t best = 0;
+    int best_area = 0;
+    for (const auto& group : groups) {
+      int area = group.first.first * group.first.second;
+      if (group.second.size() >= 3 &&
+          (group.second.size() > best ||
+           (group.second.size() == best && area > best_area))) {
+        best = group.second.size();
+        best_area = area;
+        rects = group.second;
+      }
+    }
+  }
+  return rects;
+}
