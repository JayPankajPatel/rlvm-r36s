+// On-screen areas of all visible button graphics objects (title/menu buttons
+// that the game script hit-tests against the pointer itself).
+std::vector<Rect> VisibleButtonRects(RLMachine& machine) {
+  std::vector<Rect> rects;
+  GraphicsSystem& graphics = machine.system().graphics();
+  for (GraphicsObject& obj : graphics.GetForegroundObjects()) {
+    if (obj.IsButton() && obj.visible() && obj.has_object_data()) {
+      rects.push_back(obj.GetObjectData().DstRect(obj, NULL));
+    } else if (obj.has_object_data()) {
+      ParentGraphicsObjectData* parent =
+          dynamic_cast<ParentGraphicsObjectData*>(&obj.GetObjectData());
+      if (parent) {
+        for (GraphicsObject& child : parent->objects()) {
+          if (child.IsButton() && child.visible() && child.has_object_data())
+            rects.push_back(child.GetObjectData().DstRect(child, &obj));
+        }
+      }
+    }
+  }
+
+  if (rects.empty()) {
+    // Many menus (e.g. the title screen) are plain objects that the game
+    // script hit-tests itself. Treat the largest group of three or more
+    // visible, identically sized, smallish objects as the menu entries.
+    Size screen = graphics.screen_size();
+    std::map<std::pair<int, int>, std::vector<Rect>> groups;
+    for (GraphicsObject& obj : graphics.GetForegroundObjects()) {
+      if (!obj.visible() || !obj.has_object_data())
+        continue;
+      Rect r = obj.GetObjectData().DstRect(obj, NULL);
+      if (r.width() <= 0 || r.height() <= 0 || r.x() < 0 || r.y() < 0 ||
+          r.x2() > screen.width() || r.y2() > screen.height())
+        continue;
+      if (r.width() * r.height() > screen.width() * screen.height() / 8)
+        continue;
+      groups[std::make_pair(r.width(), r.height())].push_back(r);
+    }
+    size_t best = 0;
+    for (const auto& group : groups) {
+      if (group.second.size() >= 3 && group.second.size() > best) {
+        best = group.second.size();
+        rects = group.second;
+      }
+    }
+  }
+  return rects;
+}
+
+}  // namespace
