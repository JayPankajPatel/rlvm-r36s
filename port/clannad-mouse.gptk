# mouse mode: left stick OR D-pad moves the pointer.
# A=click, B=right click (menu), X=Enter, Y/Start=Esc, L1/R1=Ctrl (skip),
# hold L2 for slow, precise pointer movement.
a = mouse_left
b = mouse_right
x = enter
y = esc
start = esc
up = mouse_movement_up
down = mouse_movement_down
left = mouse_movement_left
right = mouse_movement_right
left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right
l1 = ctrl
r1 = ctrl
l2 = mouse_slow
# wide dead zone: earlier the stick drifted the pointer into a corner
deadzone_mode = scaled_radial
deadzone = 9000
