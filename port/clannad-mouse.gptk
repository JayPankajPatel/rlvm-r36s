# Left stick moves the pointer. D-pad = arrow keys: in menus and choice lists
# it jumps between the buttons (then A clicks); while reading, Up/Down scroll
# the backlog. A=click, B=right click (menu), X=Enter, Y/Start=Esc,
# L1/R1=Ctrl (skip), hold L2 for slow, precise pointer movement.
a = mouse_left
b = mouse_right
x = enter
y = esc
start = esc
up = up
down = down
left = left
right = right
left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right
l1 = ctrl
r1 = ctrl
l2 = mouse_slow
# wide dead zone: earlier the stick drifted the pointer into a corner
deadzone_mode = scaled_radial
deadzone = 9000
# pointer speed at full stick (pixels per tick); raise for faster, lower for slower
deadzone_scale = 4
# hold L2 to slow the pointer to this percent
mouse_slow_scale = 40
